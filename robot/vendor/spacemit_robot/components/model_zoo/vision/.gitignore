.claude/

# --- 编译产物 ---
build/
bin/
lib/
*.o
*.a
*.so
*.dylib
*.exe
# --- Python 缓存 ---
__pycache__/
*.py[cod]
*$py.class
dist/
build/
*.egg-info/
venv/
.venv/
test_env/
modelzoo_vision.egg-info/
/config/

# --- 模型与大数据（见大文件策略） ---
*.onnx
*.gguf
*.weights
*.bin
*.tar.gz
*.zip
*.mp4
*.jpg
*.png
# --- IDE 与系统 ---
.vscode/
.idea/
.DS_Store
*.swp

# Legacy per-example/per-app model dirs (no longer used; models go to ~/.cache/models/vision/)
examples/*/model/
applications/*/models/

# Model dirs in src/deploy that have no example (ignore to avoid untracked deploy-only models)
.cursorignore
docs/design_roadmap.md
docs/_rewrite_spec.md
.cursor/
ai_gateway.md
vision_openapi/
mpp/
applications/rtsp_detection/
applications/rtsp_tracking/

# --- Python wheel 工程（src/python）构建产物 ---
# 扩展与 libvision.so 由构建时拷入包目录，不入库（*.so 已被全局忽略）。
src/python/build/
src/python/.cmake-build/
src/python/dist/
src/python/spacemit_vision/*.so
src/python/spacemit_vision.egg-info/
docs_local/
