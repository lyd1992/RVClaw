{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RVClaw Person Tracking Stream",
  "type": "object",
  "required": ["source", "stream", "runtime", "tracks"],
  "properties": {
    "source": {
      "type": "object",
      "required": ["type", "name", "replaceable_with", "topic", "adapter"],
      "properties": {
        "type": { "type": "string", "enum": ["demo-video", "ros2-camera"] },
        "name": { "type": "string" },
        "replaceable_with": { "type": "string", "enum": ["ros2_camera_topic"] },
        "topic": { "type": "string" },
        "adapter": { "type": "string" },
        "transport": { "type": "string", "enum": ["browser-canvas", "ros2-image-topic"] }
      }
    },
    "stream": {
      "type": "object",
      "required": ["width", "height", "fps", "duration_sec", "timestamp"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "type": "number", "minimum": 1 },
        "duration_sec": { "type": "number", "minimum": 1 },
        "timestamp": { "type": "string", "format": "date-time" },
        "frame_id": { "type": "string" },
        "encoding": { "type": "string" }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["target", "backend", "model", "offline"],
      "properties": {
        "target": { "type": "string" },
        "backend": { "type": "string" },
        "model": { "type": "string" },
        "offline": { "type": "boolean" },
        "available": { "type": "boolean" },
        "status": { "type": "string" },
        "message": { "type": ["string", "null"] }
      }
    },
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["track_id", "label", "confidence", "safety_state", "bbox", "model"],
        "properties": {
          "track_id": { "type": "string" },
          "label": { "type": "string" },
          "value": { "type": ["string", "number", "null"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "safety_state": { "type": "string" },
          "model": { "type": "string", "enum": ["yolov8n"] },
          "timestamp": { "type": "string", "format": "date-time" },
          "bbox": {
            "type": "object",
            "required": ["x", "y", "width", "height"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "width": { "type": "number", "minimum": 1 },
              "height": { "type": "number", "minimum": 1 }
            }
          }
        }
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["track_id", "label", "confidence", "safety_state", "keyframes"],
        "properties": {
          "track_id": { "type": "string" },
          "label": { "type": "string", "enum": ["person"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "safety_state": { "type": "string" },
          "keyframes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["t", "bbox"],
              "properties": {
                "t": { "type": "number", "minimum": 0, "maximum": 1 },
                "bbox": {
                  "type": "object",
                  "required": ["x", "y", "width", "height"],
                  "properties": {
                    "x": { "type": "number" },
                    "y": { "type": "number" },
                    "width": { "type": "number", "minimum": 1 },
                    "height": { "type": "number", "minimum": 1 }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
