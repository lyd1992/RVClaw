{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RVClaw Device Status",
  "type": "object",
  "required": ["timestamp", "chassis", "camera", "lidar", "imu"],
  "properties": {
    "timestamp": { "type": "string", "format": "date-time" },
    "chassis": { "type": "string", "enum": ["online", "offline", "fault"] },
    "camera": { "type": "string", "enum": ["online", "offline", "fault"] },
    "lidar": { "type": "string", "enum": ["online", "offline", "fault"] },
    "imu": { "type": "string", "enum": ["online", "offline", "fault"] },
    "battery_percent": { "type": ["number", "null"] },
    "cpu_percent": { "type": ["number", "null"] },
    "memory_percent": { "type": ["number", "null"] },
    "temperature_c": { "type": ["number", "null"] }
  }
}
