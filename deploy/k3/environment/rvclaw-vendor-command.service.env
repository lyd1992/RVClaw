SROBOTIS_ROOT="/data/spacemit_robot"
RVCLAW_VOICE_ENABLE_INSPECTION="1"
RVCLAW_VOICE_ENABLE_MOTION="0"
PYTHONUNBUFFERED="1"
PYTHONPATH="@ROBOT_ROOT@/services/rvclaw_voice:/data/spacemit_robot/output/build/cmake/pkgs/components_model_zoo_asr/python:/data/spacemit_robot/output/staging/lib/python"
LD_LIBRARY_PATH="/data/spacemit_robot/output/staging/lib"
RVCLAW_TASK_DB="/data/RVClaw/runtime/voice_tasks.sqlite3"
RVCLAW_VOICE_DIAGNOSTIC_DIR="/data/RVClaw/runtime/voice-diagnostics"
RVCLAW_ROUTE_SCRIPT="@ROBOT_ROOT@/runtime/k3/mission/scripts/nav2_persistent_route.sh"
RVCLAW_ROUTE_RUN_ROOT="@ROBOT_ROOT@/runtime/k3/mission/runs/inspection"
RVCLAW_LAB_ROOT="@ROBOT_ROOT@/runtime/k3/mission"
RVCLAW_INSPECTION_CONFIG="@ROBOT_ROOT@/configs/scenes/inspection/inspection_route_tasks.yaml"
RVCLAW_M260C_IDLE_REARM_SECONDS="300"
RVCLAW_M260C_HANDSHAKE_TIMEOUT_SECONDS="75"
RVCLAW_M260C_REARM_DELAY_SECONDS="0.35"
RVCLAW_AUDIO_CAPTURE_RETRY_SECONDS="1.0"
RVCLAW_LOCAL_WAKE_FALLBACK="1"
RVCLAW_LOCAL_WAKE_SILENCE_SECONDS="0.70"
RVCLAW_LOCAL_WAKE_NO_SPEECH_SECONDS="2.0"
RVCLAW_LOCAL_WAKE_MAXIMUM_SECONDS="7.0"
RVCLAW_LOCAL_WAKE_PREROLL_SECONDS="0.75"
RVCLAW_LOCAL_WAKE_MIN_CONFIDENCE="0.78"
RVCLAW_CROSS_SOURCE_WAKE_DEDUP_SECONDS="0.75"
RVCLAW_UNPARSED_PROMPT_MIN_SPEECH_SECONDS="0.60"
RVCLAW_VENDOR_WAKE_REPLAY_DEDUP_SECONDS="8.0"
RVCLAW_REARM_AFTER_WAKE_ACK="1"
RVCLAW_ACTIVE_WAKE_PROBE_SILENCE_SECONDS="0.75"
RVCLAW_AUDIO_DRAIN_QUIET_SECONDS="0.0"
RVCLAW_BASE_ROOT="@ROBOT_ROOT@/runtime/k3/base"
RVCLAW_LOCALIZATION_CACHE="@ROBOT_ROOT@/runtime/k3/navigation/state/localization-pose.json"
RVCLAW_MAP_FILE="@ROBOT_ROOT@/configs/scenes/inspection/map.yaml"
RVCLAW_NAV2_WAYPOINTS_FILE="@ROBOT_ROOT@/configs/scenes/inspection/waypoints.yaml"
RVCLAW_VOICE_ENABLE_MAPPING="1"
RVCLAW_MAPPING_SCRIPT="@ROBOT_ROOT@/deploy/k3/mapping_entry.sh"
RVCLAW_MAPPING_RUN_ROOT="@ROBOT_ROOT@/runtime/k3/mapping/runs/voice-mapping"
RVCLAW_MAPPING_MAP_ROOT="@ROBOT_ROOT@/runtime/k3/mapping/maps"
RVCLAW_MAPPING_STATE_ROOT="/data/RVClaw/runtime/manual-mapping"
RVCLAW_MAPPING_LATEST_FILE="@ROBOT_ROOT@/runtime/k3/mapping/state/manual-mapping-latest.json"
RVCLAW_MAPPING_START_TIMEOUT_S="90"
RVCLAW_MAPPING_SAVE_TIMEOUT_S="75"
RVCLAW_MAPPING_STATIONARY_DURATION_S="5"
RVCLAW_MAPPING_STATIONARY_MIN_MESSAGES="20"
RVCLAW_NAV_SERVICE="rvclaw-nav2-persistent.service"
RVCLAW_PROMPT_PLAYBACK_TIMEOUT="20"
RVCLAW_PROMPT_ECHO_SUPPRESS_SECONDS="0.12"
RVCLAW_ROUTE_CHECKPOINT_FILE="@ROBOT_ROOT@/runtime/k3/navigation/state/inspection-route-checkpoint.json"
RVCLAW_SITE_DIR="@ROBOT_ROOT@/configs/scenes/inspection"
RVCLAW_FRONT_SCAN_HALF_ANGLE_DEG="70.0"
RVCLAW_LOCALIZATION_SCAN_HALF_ANGLE_DEG="70.0"
RVCLAW_M260C_WAKE_KEYWORD="xiao3 wei1 xiao3 wei1"
RVCLAW_M260C_WAKE_THRESHOLD="700"
